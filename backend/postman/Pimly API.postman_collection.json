            },
            "url": "{{baseUrl}}/api/v1/channels/marketplaces/trendyol/connection",
            "description": "Pazaryeri bağlantısını oluşturur veya günceller."
          }
        },
        {
          "name": "Get Taxonomy Status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/channels/marketplaces/trendyol/taxonomy/status",
            "description": "Son sync durumu ve cache'lenmiş kategori sayısı."
          }
        },
        {
          "name": "Search External Categories",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/channels/marketplaces/trendyol/categories?q=telefon&limit=25",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "channels", "marketplaces", "trendyol", "categories"],
              "query": [
                { "key": "q", "value": "telefon" },
                { "key": "limit", "value": "25" }
              ]
            },
            "description": "Cache'lenmiş Trendyol kategorilerinde arama."
          }
        }
      ]
    }
