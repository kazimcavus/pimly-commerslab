            "url": "{{baseUrl}}/api/v1/channels/marketplaces",
            "description": "Desteklenen pazaryerlerini listeler. Yanıt: `[{ id, key, name, is_active, is_configured }]`"
          }
        },
        {
          "name": "Get Marketplace Connection",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/channels/marketplaces/trendyol/connection",
            "description": "Pazaryeri API bağlantı bilgilerini getirir (gizli alanlar maskelenir). Yanıt: `{ id, marketplace_key, seller_id, has_api_key, has_api_secret, api_key_hint, is_enabled }`"
          }
        },
        {
          "name": "Upsert Marketplace Connection",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
