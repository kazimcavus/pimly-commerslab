{
  "info": {
    "_postman_id": "pimly-api-v1",
    "name": "Pimly API",
    "description": "Pimly v1 REST API collection.\n\n**Base URL:** `http://localhost:7000` (Development)\n\n**Auth:** Önce **Identity → Login** isteğini çalıştırın. Yanıttaki JWT otomatik olarak `token` değişkenine kaydedilir.\n\n**Dev kullanıcı:** `owner@acme.test` / `demo1234`\n\n**JSON format:** Tüm istek ve yanıtlar `snake_case` kullanır.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:7000" },
    { "key": "token", "value": "" },
    { "key": "categoryId", "value": "00000000-0000-0000-0000-000000000001" },
    { "key": "attributeId", "value": "00000000-0000-0000-0000-000000000002" },
    { "key": "attributeValueId", "value": "00000000-0000-0000-0000-000000000003" },
    { "key": "categoryAttributeId", "value": "00000000-0000-0000-0000-000000000004" },
    { "key": "variantTypeId", "value": "00000000-0000-0000-0000-000000000005" },
    { "key": "variantValueId", "value": "00000000-0000-0000-0000-000000000006" },
    { "key": "productId", "value": "00000000-0000-0000-0000-000000000007" },
    { "key": "productItemId", "value": "00000000-0000-0000-0000-000000000008" },
    { "key": "productImageId", "value": "00000000-0000-0000-0000-000000000009" },
    { "key": "groupId", "value": "00000000-0000-0000-0000-000000000010" }
  ],
  "item": [
    {
      "name": "Identity",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('token', body.token);",
                  "    pm.test('Token saved', () => pm.expect(body.token).to.be.a('string').and.not.empty);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@acme.test\",\n  \"password\": \"demo1234\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/identity/login",
            "description": "JWT alır. Yanıt: `{ token, expires_at, user: { id, email, name } }`"
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/identity/me"
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/healthz"
          }
        },
        {
          "name": "Readiness",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/ready"
          }
        }
      ]
    },
