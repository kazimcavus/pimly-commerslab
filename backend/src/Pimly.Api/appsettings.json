{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Observability": {
    "Enabled": true,
    "ServiceName": "pimly-api",
    "ServiceVersion": "1.0.0",
    "MetricsPath": "/metrics",
    "ExcludePathsFromRequestLogging": [
      "/healthz",
      "/ready",
      "/metrics",
      "/media"
    ],
    "Tracing": {
      "Enabled": true,
      "OtlpEndpoint": "http://localhost:4317",
      "SamplingRatio": 1.0,
      "IncludeSqlStatements": false
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=pimly;Username=pimly;Password=pimly",
    "Identity": "Host=localhost;Port=5432;Database=pimly;Username=pimly;Password=pimly"
  },
  "Catalog": {
    "AutoMigrate": true
  },
  "Channels": {
    "AutoMigrate": true,
    "UseStubTaxonomyClient": true,
    "WorkerPollIntervalSeconds": 5,
    "TaxonomySyncSchedule": {
      "Enabled": true,
      "CheckIntervalSeconds": 60,
      "TimesUtc": [ "00:00", "08:00", "16:00" ]
    }
  },
  "Identity": {
    "AutoMigrate": true,
    "Jwt": {
      "Secret": "change-me-in-production",
      "ExpirationHours": 24
    }
  },
  "Media": {
    "StoragePath": "./storage/media",
    "PublicBaseUrl": "",
    "AllowedUrlPrefix": "/media/"
  }
}
