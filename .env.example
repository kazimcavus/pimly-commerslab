# pimly configuration (env). Copy to .env and adjust.

# --- HTTP server ---
PIMLY_HTTP_ADDR=:8080

# --- Database (PostgreSQL) ---
# Used by both the app pool and the global migration runner.
PIMLY_DATABASE_URL=postgres://pimly:pimly@localhost:5432/pimly?sslmode=disable
# Pool sizing (low-resource defaults).
PIMLY_DB_MAX_CONNS=8
PIMLY_DB_MIN_CONNS=1

# --- Auth ---
# HS256 signing secret for JWT bearer tokens. MUST be set to a long random value in prod.
PIMLY_JWT_SECRET=dev-only-change-me-to-a-long-random-secret
# Access token lifetime.
PIMLY_JWT_TTL=24h

# --- Admin ---
# Static token for platform admin endpoints (X-Admin-Token header).
# Leave empty to disable all /admin/* endpoints.
PIMLY_ADMIN_TOKEN=

# --- Object storage (MinIO / S3-compatible) ---
PIMLY_S3_ENDPOINT=localhost:9000
PIMLY_S3_ACCESS_KEY=pimly
PIMLY_S3_SECRET_KEY=pimly-secret
PIMLY_S3_BUCKET=pimly-media
PIMLY_S3_USE_SSL=false
# Public base URL used to build media URLs (e.g. http://localhost:9000/pimly-media).
PIMLY_S3_PUBLIC_BASE_URL=http://localhost:9000/pimly-media

# --- Logging ---
# debug | info | warn | error
PIMLY_LOG_LEVEL=info
# text | json
PIMLY_LOG_FORMAT=text
