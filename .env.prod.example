# Pimly production ortam değişkenleri örneği.
# VPS'te: cp .env.prod.example .env.prod && nano .env.prod
# .env.prod ASLA git'e commit edilmez (.gitignore'da).

# --- Alan adı ve TLS ---
# Caddy bu alan adı için Let's Encrypt sertifikasını otomatik alır.
# DNS A kaydı bu sunucuya işaret etmeli, 80/443 portları açık olmalı.
PIMLY_DOMAIN=pimly.example.com

# Medya URL'lerinde kullanılan genel taban adres (şema dahil).
PUBLIC_BASE_URL=https://pimly.example.com

# --- Veritabanı ---
POSTGRES_USER=pimly
POSTGRES_DB=pimly
# GÜÇLÜ bir parola üretin: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-strong-password

# --- Kimlik doğrulama ---
# JWT imzalama anahtarı; EN AZ 32 bayt olmalı.
# Üretmek için: openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-bytes-long-secret

# --- Pazaryeri (Trendyol) ---
TRENDYOL_API_BASE_URL=https://apigw.trendyol.com

# PAZARYERİNE YAZMA GÜVENLİK ANAHTARI.
# true  → listing-sync ve publications worker'ları stub istemci kullanır;
#         Trendyol'a HİÇBİR yazma isteği (fiyat/stok/ürün kartı) gitmez.
#         Taksonomi ve ürün import'u da stub veriyle çalışır.
# false → GERÇEK Trendyol istemcileri devreye girer; mağazanızdaki fiyat/stok
#         güncellenir ve yeni ürün kartları açılır.
#
# İlk kurulumda true bırakın; sistemin çalıştığını doğruladıktan sonra
# bilinçli olarak false yapıp servisleri yeniden başlatın.
CHANNELS_USE_STUB_CLIENTS=true

# --- İzleme (opsiyonel) ---
# docker-compose.monitoring.yml ile birlikte çalıştırıyorsanız true yapın.
TRACING_ENABLED=false

# Grafana yönetici parolası (monitoring profili kullanılıyorsa).
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
